{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trustmarkets",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "WORKER_SECRET": "dev-secret-change-me"
  },
  "routes": [
    { "pattern": "p2pmarket.net", "custom_domain": true },
    { "pattern": "www.p2pmarket.net", "custom_domain": true },
    { "pattern": "trustmarkets.net", "custom_domain": true },
    { "pattern": "www.trustmarkets.net", "custom_domain": true }
  ]
}
